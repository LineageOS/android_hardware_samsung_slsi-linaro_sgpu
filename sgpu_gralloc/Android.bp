sgr_common_core_srcs = [
    "src/core/camera_format_manager.cpp",
    "src/core/cpu_format_manager.cpp",
    "src/core/dcc_layout_manager.cpp",
    "src/core/exynos_ion_memory_manager.cpp",
    "src/core/format_info.cpp",
    "src/core/format_manager.cpp",
    "src/core/hwc_format_manager.cpp",
    "src/core/ip_format_manager.cpp",
    "src/core/linear_layout_manager.cpp",
    "src/core/metadata_manager.cpp",
    "src/core/sbwc_layout_manager.cpp",
    "src/core/sgpu_format_manager.cpp",
    "src/core/video_format_manager.cpp",
]

sgr_common_shared_libs = [
    "libbase",
    "libc++",
    "libcutils",
    "libeis_utils",
    "libgralloctypes",
    "libhardware",
    "libhidlbase",
    "libion_exynos",
    "liblog",
    "libutils",
]

cc_defaults {
    name: "sgr_defaults",
    include_dirs: [
        "hardware/samsung_slsi-linaro/exynos/include",
        "hardware/samsung_slsi-linaro/sgpu/sgpu_gralloc/src",
    ],
    relative_install_path: "hw",
    srcs: sgr_common_core_srcs,
    shared_libs: sgr_common_shared_libs,

    cflags: select(soong_config_variable("sgr", "enable_swizzle_4k_mode"), {
        true: ["-DENABLE_SWIZZLE_4K_MODE"],
        default: [],
    })
}

cc_binary {
    name: "android.hardware.graphics.allocator-aidl-service-sgr",
    defaults: [
        "sgr_defaults",
    ],
    proprietary: true,
    srcs: [
        "src/core/allocator.cpp",
        "src/gralloc4/AllocatorAidl.cpp",
        "src/gralloc4/service.cpp",
    ],
    init_rc: [
        "src/gralloc4/android.hardware.graphics.allocator-aidl-service-sgr.rc",
    ],
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
        "android.hardware.graphics.mapper@4.0-impl-sgr",
        "libbinder_ndk"
    ],
    static_libs : ["libaidlcommonsupport"]
}

cc_library_shared {
    name: "android.hardware.graphics.mapper@4.0-impl-sgr",
    defaults: [
        "sgr_defaults",
    ],
    vendor: true,
    srcs: [
        "src/core/mapper.cpp",
        "src/gralloc4/MapperHidl.cpp",
        "src/interface/g_private_handle_interface.cpp",
    ],
    export_include_dirs: ["."],
    shared_libs: [
        "android.hardware.graphics.mapper@4.0",
        "libsync",
    ],
    header_libs: [
        "libhardware_headers",
        "libnativebase_headers",
    ],
}

cc_library_shared {
    name: "mapper.sgr",
    defaults: [
        "sgr_defaults",
    ],
    vintf_fragments: ["src/gralloc5/mapper.sgr.xml"],
    vendor: true,
    srcs: [
        "src/core/mapper.cpp",
        "src/gralloc5/MapperStableC.cpp",
        "src/interface/g_private_handle_interface.cpp",
    ],
    export_include_dirs: ["."],
    shared_libs : [
        "android.hardware.graphics.common-V7-ndk",
        "libsync",
    ],
    header_libs: [
        "libimapper_providerutils",
        "libimapper_stablec",
    ],
}